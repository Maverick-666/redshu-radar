<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maverick.redshu-radar.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>__PROJECT_DIR__/venv/bin/python</string>
    <string>-m</string>
    <string>redshu_radar.cli</string>
    <string>--data-dir</string>
    <string>__DATA_DIR__</string>
    <string>collect</string>
    <string>--trigger</string>
    <string>daily</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>0</integer>
    <key>Minute</key>
    <integer>2</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__DATA_DIR__/collector.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DATA_DIR__/collector.stderr.log</string>
</dict>
</plist>
